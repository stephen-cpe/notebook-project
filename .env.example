# =============================================================================
# notebook-project environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env.
# =============================================================================

# --- Flask ---
SECRET_KEY=change-me-to-a-random-string
FLASK_PORT=5000
# Session cookie hardening. HttpOnly + SameSite=Lax are on by default.
# Set SECURE=true for HTTPS deployments.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# --- Database (PostgreSQL required in production; SQLite for tests) ---
DATABASE_URL=postgresql+psycopg2://notebook_user:notebook_pass@localhost:5432/notebook_project
TEST_DATABASE_URL=sqlite:///:memory:

# --- AI / Ollama Cloud ---
AI_MOCK=false
OLLAMA_CLOUD_BASE_URL=https://your-ollama-cloud-host
OLLAMA_CLOUD_API_KEY=your-ollama-cloud-key
OLLAMA_TIMEOUT=300
CHAT_MODEL=gemma4:31b-cloud
ENABLE_THINKING=true

# --- Embeddings (HuggingFace) ---
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=1024
# Provider: "local" (default) runs sentence-transformers on your machine — no
# network traffic per embedding call, but requires disk for weights and CPU/GPU
# for inference. "hf_inference" uses Hugging Face's hosted Inference API — no
# local weights/compute, but per-call network latency and requires HF_TOKEN.
EMBEDDING_PROVIDER=local
# Optional: dedicated TEI endpoint (e.g. https://xxx.tei.huggingface.cloud).
# Empty -> default HF Inference router (https://api-inference.huggingface.co).
# Only used when EMBEDDING_PROVIDER=hf_inference.
HF_INFERENCE_ENDPOINT=
# Optional HF READ token to suppress rate-limit warnings on model download/inference.
# Absent: app runs unauthenticated, logs a one-time WARNING.
# Invalid: HF returns 401/403, app logs ERROR and proceeds unauthenticated (degraded, not fatal).
HF_TOKEN=
# Timeout (seconds) for HuggingFace Inference API calls (embeddings + OCR).
HF_TIMEOUT_SECONDS=60

# --- Vision OCR (Ollama glm-5.3-flash, consolidated understanding) ---
# Replaces the old HuggingFace GLM-OCR path. All image OCR, table
# extraction, and figure description use this single natively multimodal
# model via the Ollama Cloud chat API (reuses OLLAMA_CLOUD_* above).
# OCR_PROVIDER / OCR_INFERENCE_ENDPOINT / HF_TOKEN below are deprecated
# aliases kept for old .env files; they no longer select the backend.
OLLAMA_VISION_MODEL=glm-5.3-flash:cloud
OLLAMA_VISION_TIMEOUT=300
OCR_FALLBACK_ENABLED=true
OCR_TEXT_THRESHOLD=200
OCR_MAX_IMAGE_DIMENSION=2048
POPPLER_PATH=
# Smart gate: text-layer PDFs skip vision entirely. Vision runs only when a
# PDF looks scanned/image-heavy (total chars below, or per-page below, or
# embedded images outnumber pages).
PDF_NEEDS_OCR_MIN_TOTAL_CHARS=1000
PDF_NEEDS_OCR_MIN_CHARS_PER_PAGE=300
# Describe figures/diagrams during the vision pass (searchable captions).
OCR_FIGURE_DESCRIPTION=true
# Provider: "local" (default) runs transformers on your machine — no network
# traffic per OCR call, but requires disk for weights and CPU/GPU for inference.
# "hf_inference" uses Hugging Face's hosted Inference API — no local weights,
# per-call network latency, requires HF_TOKEN.
OCR_PROVIDER=local
# Optional: dedicated inference endpoint for GLM-OCR.
# Empty -> default HF Inference router.
OCR_INFERENCE_ENDPOINT=
# Max pages to OCR per PDF (prevents memory exhaustion on large files).
OCR_MAX_PAGES=30
# DPI for PDF-to-image rendering during OCR.
OCR_DPI=150

# --- Vector store ---
CHROMA_DB=local
DATA_DIR=./data
# Chroma Cloud credentials (only required when CHROMA_DB=cloud).
# If CHROMA_DB=cloud and any of these are missing/empty or the connection
# probe fails, the app logs the error and reverts to the local PersistentClient.
# CHROMA_CLOUD_CONNECTION_STRING is the Chroma tenant ID.
# CHROMA_COLLECTION_NAME becomes the Chroma Cloud database name; the app's
# per-file collections (doc_<filehash>) live inside it.
CHROMA_CLOUD_API_KEY=
CHROMA_CLOUD_CONNECTION_STRING=
CHROMA_COLLECTION_NAME=notebook-project-chromadb

# --- Sources ---
MAX_SOURCES_PER_NOTEBOOK=50
MAX_FILE_SIZE_MB=25

# --- Audio ---
OVERVIEW_MIN_DURATION_SECONDS=60
OVERVIEW_MAX_DURATION_SECONDS=480
# Max characters of source text fed to the LLM when generating summary/audio/
# video overviews. Sources are included in upload order until the budget is
# reached; the cached section digest covers whatever exceeds it.
OVERVIEW_MAX_CONTEXT_CHARS=150000

# --- RAG budget (context-window-derived retrieval) ---
# Sized for a 256K-window chat model: retrieval depth scales with
# OLLAMA_NUM_CTX, and RAG_MAX_CONTEXT_CHARS is the real ceiling enforced
# on every chat prompt (no hidden caps). RAG_SUMMARY_MAP prepends a
# full-coverage digest so long docs are not just top-k skimmed.
OLLAMA_NUM_CTX=262144
RAG_TOP_K=20
RAG_MAX_TOP_K=200
RAG_MAX_CONTEXT_CHARS=700000
# Visible citation badges per answer (top-N by relevance); the full count
# shows behind the "Sources (N of M)" toggle. Retrieval breadth is unaffected.
RAG_MAX_CITATIONS=12
RAG_SUMMARY_MAP=true
RAG_DIGEST_MAX_CHARS=80000
RAG_MAP_SECTION_CHARS=6000
RAG_MAP_MAX_SECTIONS=80

# --- Suggested questions (dedup + opt-in web augmentation, fail-closed) ---
# Web search fires only for public topics when internal doc topics run out.
# Reuses OLLAMA_CLOUD_API_KEY/BASE_URL (no new secret).
WEB_SEARCH_ENABLED=false
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=30
WEB_SEARCH_SYNTH_MODEL=gpt-oss:20b-cloud

# --- Diagrams → Mermaid (optional figure reinterpretation) ---
DIAGRAM_TO_MERMAID=true
DIAGRAM_MIN_CONFIDENCE=80
DIAGRAM_VERIFY=true

# --- Admin seed (first run only) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- CI / test flags ---
CI=false
RUN_INTEGRATION=0

# --- Voice mode ---
# Enable hands-free voice mode (toggle). When false, voice routes/UI are not
# registered and the microphone button is hidden.
VOICE_ENABLED=false
# STT provider: "local" (faster-whisper, default) — downloads a model on first
# use. In AI_MOCK=true mode a deterministic mock is used (no model download).
VOICE_STT_PROVIDER=local
# faster-whisper model size: tiny.en, base.en, small.en, medium.en (CPU default: base.en).
VOICE_STT_MODEL=base.en
# Device: "cpu" (default) or "cuda" (auto-detected where practical).
VOICE_STT_DEVICE=cpu
# Compute type: int8 (CPU default), float16 (GPU safe).
VOICE_STT_COMPUTE_TYPE=int8
# Optional language hint (BCP-47, e.g. "en"). Empty = auto-detect.
VOICE_STT_LANGUAGE=
# Max recording length (seconds) and upload size (MB) enforced server-side.
VOICE_MAX_RECORDING_SECONDS=60
VOICE_MAX_UPLOAD_MB=10
# Fallback TTS speaker name when synthesis has no preference.
VOICE_TTS_FALLBACK_SPEAKER=Ava
# SocketIO CORS origins (empty = same-origin).
VOICE_CORS_ORIGINS=
